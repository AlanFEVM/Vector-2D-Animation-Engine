<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VectorAnimationEngine</AssemblyName>
    <RootNamespace>VectorAnimationEngine</RootNamespace>
    <ApplicationIcon>..\assets\branding\vector2d-icon.ico</ApplicationIcon>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VectorAnimationEngine.ReleaseManager" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeMinecraftSceneExtension)' != 'false'">
    <None Update="Extensions\MinecraftScene\minecraft-scene.v2dextension"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Keep the complete local texture library out of the size-limited single-EXE payload. -->
    <None Update="Extensions\MinecraftScene\Textures\**\*"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeMinecraftSceneExtension)' == 'false'">
    <Compile Remove="Extensions\MinecraftScene\**\*.cs" />
    <None Remove="Extensions\MinecraftScene\minecraft-scene.v2dextension" />
    <None Remove="Extensions\MinecraftScene\Textures\**\*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ApplicationIcon)"
                      LogicalName="$(RootNamespace).Application.ico" />
    <EmbeddedResource Include="..\release\release-notes.json"
                      Link="ReleaseNotes\release-notes.json"
                      LogicalName="VectorAnimationEngine.ReleaseNotes.release-notes.json" />
    <EmbeddedResource Include="..\assets\branding\vector2d-project.ico"
                      LogicalName="$(RootNamespace).ProjectFile.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="Svg" Version="3.4.7" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>
</Project>
