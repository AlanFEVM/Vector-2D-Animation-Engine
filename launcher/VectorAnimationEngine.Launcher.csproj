<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VectorAnimationEngine</AssemblyName>
    <RootNamespace>VectorAnimationEngine.Launcher</RootNamespace>
    <AssemblyTitle>Vector 2D Animation Engine Development Launcher</AssemblyTitle>
    <Product>Vector 2D Animation Engine Development Launcher</Product>
    <Description>Source development launcher with dotnet watch and module hot reload.</Description>
  </PropertyGroup>
</Project>
